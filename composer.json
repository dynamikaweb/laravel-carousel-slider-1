{
    "name": "dynamikasolucoesweb/laravel-carousel-slider-1",
    "description": "Um componente Blade robusto para carrosséis de imagens usando Swiper.js 11, com suporte nativo para Spatie Media Library, layouts flexíveis (miniaturas verticais/horizontais) e Lightbox integrado.",
    "type": "library",
    "keywords": ["dynamika", "laravel", "carousel", "slider", "swiper", "media library", "component", "blade"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Giordani da Silveira dos Santos",
            "email": "giordani@dynamika.com.br"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "DynamikaSolucoesWeb\\CarouselSlider\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DynamikaSolucoesWeb\\CarouselSlider\\CarouselSlider1ServiceProvider"
            ]
        }
    }
}